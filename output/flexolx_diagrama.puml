    -imovel: Imovel
    --
    +TelaCriarProposta(parent: Frame, gerenciador: GerenciadorPropostas, comprador: Usuario, imovel: Imovel)
    -enviar(): void
  }

  class TelaMinhasPropostas {
    -gerenciador: GerenciadorPropostas
    -usuarioLogado: Usuario
    -tabela: JTable
    -tableModel: DefaultTableModel
    -btnAceitar: JButton
    -btnRecusar: JButton
    --
    +TelaMinhasPropostas(gerenciador: GerenciadorPropostas, usuarioLogado: Usuario)
    -inicializarComponentes(): void
    -carregarPropostas(): void
    -responderProposta(aceitar: boolean): void
  }

}

package "br.com.flexolx.api" {
  class RecursoNaoEncontradoException {
    +RecursoNaoEncontradoException(mensagem: String)
  }

}

package "br.com.flexolx.api.config" {
  class CorsConfig {
    +addCorsMappings(registry: CorsRegistry): void
  }

  class DataSeeder {
    -{static} log: Logger = LoggerFactory.getLogger(DataSeeder.class)
    -catalogo: GerenciadorCatalogo
    -usuarios: GerenciadorUsuarios
    --
    +DataSeeder(catalogo: GerenciadorCatalogo, usuarios: GerenciadorUsuarios)
    +run(args: String): void
  }

  class GerenciadoresConfig {
    +gerenciadorCatalogo(): GerenciadorCatalogo
    +gerenciadorUsuarios(): GerenciadorUsuarios
    +gerenciadorPropostas(): GerenciadorPropostas
  }

}

package "br.com.flexolx.api.controller" {
  class AuthController {
    -usuarios: GerenciadorUsuarios
    --
    +AuthController(usuarios: GerenciadorUsuarios)
    +login(body: LoginRequest): UsuarioResponse
    +register(body: RegisterRequest): ResponseEntity<UsuarioResponse>
  }

  class GlobalExceptionHandler {
    -{static} log: Logger = LoggerFactory.getLogger(GlobalExceptionHandler.class)
    --
    +tratarAutenticacao(e: AutenticacaoException): ResponseEntity<ErroResponse>
    +tratarNaoEncontrado(e: RecursoNaoEncontradoException): ResponseEntity<ErroResponse>
    +tratarRequisicaoInvalida(e: RuntimeException): ResponseEntity<ErroResponse>
    +tratarProibido(e: SecurityException): ResponseEntity<ErroResponse>
    +tratarValidacao(e: MethodArgumentNotValidException): ResponseEntity<ErroResponse>
    +tratarCorpoInvalido(e: HttpMessageNotReadableException): ResponseEntity<ErroResponse>
    +tratarErroInesperado(e: Exception): ResponseEntity<ErroResponse>
  }

  class ImovelController {
    -catalogo: GerenciadorCatalogo
    --
    +ImovelController(catalogo: GerenciadorCatalogo)
    +listar(): List<ImovelResponse>
    +buscarPorId(id: String): ResponseEntity<ImovelResponse>
  }

  class PropostaController {
    -catalogo: GerenciadorCatalogo
    -usuarios: GerenciadorUsuarios
    -propostas: GerenciadorPropostas
    --
    +PropostaController(catalogo: GerenciadorCatalogo, usuarios: GerenciadorUsuarios, propostas: GerenciadorPropostas)
    +listarPorUsuario(email: String): PropostasDoUsuarioResponse
    +enviar(body: PropostaRequest): ResponseEntity<PropostaResponse>
  }

}

package "br.com.flexolx.tools" {
  class RemoverUsuarioTeste {
    +{static} main(args: String[]): void
  }

  class VisualizarDados {
    +{static} main(args: String[]): void
  }

}

package "br.com.flexolx" {
  class FlexolxApiApplication {
    +{static} main(args: String[]): void
  }

}

